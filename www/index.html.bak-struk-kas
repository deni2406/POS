  const products = (data.rekapProduk || []).filter(item => !["meja billiard", "meja pagi", "meja malam"].includes(String(item.nama_barang || "").trim().toLowerCase()));
  const txs = data.transaksi || [];
  const salesDifference = data.selisihPenjualan;
