async function submitOpeningBalance() {
  const kwhDalamInput = document.getElementById("openingBalanceKwhDalamAwal");
  const kwhLuarInput = document.getElementById("openingBalanceKwhLuarAwal");
  const error = document.getElementById("openingBalanceError");
  const button = document.getElementById("openingBalanceSubmit");
  const kwhDalamAwalText = kwhDalamInput.value.trim();
  const kwhLuarAwalText = kwhLuarInput.value.trim();
  const parseOpeningKwh = (value, label, field) => {
    if (!/^\d+(?:[.,]\d{1,2})?$/.test(value)) {
      error.textContent = `${label} harus non-negatif dengan maksimal 2 angka desimal.`;
      field.focus();
      return null;
    }
    const normalized = value.replace(",", ".");
    const numberValue = Number(normalized);
    if (!Number.isFinite(numberValue)) {
      error.textContent = `${label} harus non-negatif dengan maksimal 2 angka desimal.`;
      field.focus();
      return null;
    }
    return numberValue;
  };
  const kwhDalamAwal = parseOpeningKwh(kwhDalamAwalText, "KWh Dalam Awal", kwhDalamInput);
  if (kwhDalamAwal === null) {
    return;
  }
  const kwhLuarAwal = parseOpeningKwh(kwhLuarAwalText, "KWh Luar Awal", kwhLuarInput);
  if (kwhLuarAwal === null) {
    return;
  }
  const sessionId = (sessionStorage.getItem("pbms_session_id") || "").trim();
  const deviceId = getOrCreateDeviceId().trim();
  if (!sessionId) {
    error.textContent = "Sesi login tidak ditemukan. Silakan login kembali.";
    return;
  }
  button.disabled = true;
  error.textContent = "";
  try {
    const response = await fetch(apiUrl("/api/confirm-opening-balance"), {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Session-Id": sessionId, "X-Device-Id": deviceId },
      body: JSON.stringify({ saldo_awal: 0, saldo_kwh_dalam_awal: kwhDalamAwal, saldo_kwh_luar_awal: kwhLuarAwal, sessionId, deviceId })
    });
    const result = await response.json();
    if (!response.ok || result.success !== true) throw new Error(result.message || "Konfirmasi saldo awal gagal. Silakan coba lagi.");
    openingBalancePending = false;
    document.getElementById("openingBalanceModal").classList.remove("show");
    document.getElementById("loginScreen").classList.add("hidden");
    document.getElementById("app").classList.remove("hidden");
    if (currentKasir) document.getElementById("cashierName").childNodes[0].nodeValue = "KASIR: " + (currentKasir.nama || "") + " ";
    await muatSaldoKasLaci();
    await loadBarang();
    await fetchMejaSessions();
    if (!activeMeja || !mejaSessions[activeMeja]) await loadCartDraftServer();
    cekServer();
    updateMejaHeaderUI();
    updateSaveOrderButton();
    startSessionTimer(currentKasir?.expiresAt || sessionStorage.getItem("pbms_expires_at"));
  } catch (e) {
    error.textContent = e.message || "Konfirmasi gagal. Periksa koneksi lalu coba lagi.";
  } finally {
    button.disabled = false;
  }
}
