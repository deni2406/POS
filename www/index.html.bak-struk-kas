  const dateTime = value => { if (!value) return "—"; const date = new Date(value); return Number.isNaN(date.getTime()) ? escapeCloseHtml(value) : date.toLocaleString("id-ID"); };
  const money = value => rupiah(Number(value || 0));
  const salesDifferenceAmount = salesDifference < 0 ? `-Rp${Math.abs(salesDifference).toLocaleString("id-ID")}` : money(salesDifference);
  const kwhCard = (label, item = {}) => `<div class="close-section"><h3>KWh ${label}</h3><div class="close-kpis"><div class="close-kpi"><span>Awal</span><strong>${escapeCloseHtml(item.awal ?? 0)}</strong></div><div class="close-kpi"><span>Akhir</span><strong>${escapeCloseHtml(item.akhir ?? 0)}</strong></div><div class="close-kpi"><span>Penggunaan</span><strong>${escapeCloseHtml(item.penggunaan ?? 0)}</strong></div>${item.tokenTopupTersedia ? `<div class="close-kpi"><span>Token top-up</span><strong>${formatKwhPembelian(item.totalTokenTopup)}</strong></div>` : ""}</div></div>`;
  document.getElementById("closeReport").innerHTML = `
