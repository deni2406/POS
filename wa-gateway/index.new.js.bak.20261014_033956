// ACK VALUES yang dianggap sebagai konfirmasi sukses (bukan ERROR, bukan PENDING)
const CONFIRMED_ACK_VALUES = new Set([
    MessageAck.ACK_SERVER,
    MessageAck.ACK_DEVICE,
    MessageAck.ACK_READ,
    MessageAck.ACK_PLAYED,
]);

/**
 * PendingEntry menyimpan status satu pengiriman pesan.
 * PendingEntry disimpan di pendingSends dengan key = chatId (msg.to).
 * msg.id.id dipakai sebagai correlId internal untuk audit, bukan sebagai key Map.
 */
function createPendingEntry(chatId) {
    return {
        chatId,
        resolve: null,
        reject: null,
        confirmed: false,
        ackError: false,
        ack: undefined,
        ackTs: undefined,
        serverId: undefined,
        created: false,
        createdTs: undefined,
        _timeoutHandle: null, // handle timer agar bisa dibersihkan
        correlId: null, // msg.id.id dari event pertama, dipakai sebagai key Map setelah pendaftaran
    };
}

function clearTimeoutFor(entry) {
    if (entry._timeoutHandle !== null) {
        clearTimeout(entry._timeoutHandle);
        entry._timeoutHandle = null;
    }
}

const pendingSends = new Map();

