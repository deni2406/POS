app.post('/send', authMiddleware, async (req, res) => {
  if (!whatsappReady) {
    return res.status(503).json({
      ok: false,
      error: 'WhatsApp belum siap.'
    });
  }

  const { number, message } = req.body || {};

  if (typeof number !== 'string' ||
      !/^\d{8,15}$/.test(number)) {
    return res.status(400).json({
      ok: false,
      error: 'Nomor harus berupa kode negara dan angka saja, tanpa tanda + atau spasi.'
    });
  }

  if (typeof message !== 'string' ||
      !message.trim() ||
      message.length > 4000) {
    return res.status(400).json({
      ok: false,
      error: 'Pesan wajib diisi dan maksimal 4000 karakter.'
    });
  }

  try {
    if (!await ensureRegistered(number, numberCache)) {
      return res.status(400).json({
        ok: false,
        error: 'Nomor tidak terdaftar di WhatsApp.'
      });
    }

    const chatId = `${number}@c.us`;

    // Reject concurrent sends to the same chat (scan values, not keys)
    for (const entry of pendingSends.values()) {
      if (entry.chatId === chatId && !entry.confirmed && !entry.ackError) {
        return res.status(409).json({
          ok: false,
          error: 'Terdapat pengiriman ke nomor ini yang masih menunggu konfirmasi. Silakan coba lagi.',
          chatId
        });
      }
    }

    const pendingEntry = createPendingEntry(chatId);
    // Daftar entry by chatId untuk concurrent check dan pembersihan timeout.
    // Korelasi event (msg.id.id) dilakukan di handleSendEvent via lookupChatId().
    pendingSends.set(chatId, pendingEntry);

    const sendPromise = client.sendMessage(chatId, message.trim(), {
      waitUntilMsgSent: true
    });

    // ackPromise resolves when an ACK is received, rejects on ACK_ERROR or timeout.
    let settled = false;
    const ackPromise = new Promise((resolve, reject) => {
      pendingEntry.resolve = (payload) => {
        if (settled) return;
        settled = true;
        pendingEntry.confirmed = true;
        clearTimeoutFor(pendingEntry);
        // Bersih kan entry SETELAH resolve() dipanggil, bukan sebelum.
        if (pendingEntry.correlId && pendingSends.has(pendingEntry.correlId)) pendingSends.delete(pendingEntry.correlId);
        if (pendingSends.has(chatId)) pendingSends.delete(chatId);
        resolve(payload);
      };
      pendingEntry.reject = (err) => {
        if (settled) return;
        settled = true;
        clearTimeoutFor(pendingEntry);
        if (pendingEntry.correlId && pendingSends.has(pendingEntry.correlId)) pendingSends.delete(pendingEntry.correlId);
        if (pendingSends.has(chatId)) pendingSends.delete(chatId);
        reject(err);
      };

      const timer = setTimeout(() => {
        if (settled) return;
        settled = true;
        pendingEntry._timeoutHandle = null;
        if (pendingEntry.correlId && pendingSends.has(pendingEntry.correlId)) pendingSends.delete(pendingEntry.correlId);
        if (pendingSends.has(chatId)) pendingSends.delete(chatId);
        reject(new Error('ACK_TIMEOUT'));
      }, SEND_TIMEOUT_MS);
      pendingEntry._timeoutHandle = timer;
    });

    let sendResult = null;
    let sendError = null;
    let ackPayload = null;
    let ackTimeout = false;
    let ackError = false;

    // Jalankan sendPromise dan ackPromise bersamaan.
    // Promise.any resolves dengan hasil tercepat (send atau ACK).
    // Timeout tetap aktif membatasi total waktu tunggu HTTP.
    try {
      const fastest = await Promise.any([
        sendPromise.then((result) => ({ kind: 'send', result })),
        ackPromise.then((payload) => ({ kind: 'ack', payload }))
      ]);
      if (fastest.kind === 'send') {
        if (fastest.result && fastest.result.id && fastest.result.id._serialized) {
          sendResult = fastest.result.id._serialized;
          pendingEntry.serverId = sendResult;
        }
      } else {
        ackPayload = fastest.payload;
      }
    } catch (ackErr) {
      if (ackErr.errors) {
        // Promise.any reject: cek semua promise yang gagal
        for (const err of ackErr.errors) {
          if (err.message === 'ACK_TIMEOUT') ackTimeout = true;
          else if (err.message === 'ACK_ERROR') ackError = true;
          else sendError = err;
        }
      } else {
        sendError = ackErr;
      }
    }

    if (ackError) {
      return res.status(500).json({
        ok: false,
        error: 'Server WhatsApp mengembalikan ACK_ERROR. Pengiriman gagal.',
        chatId
      });
    }

    if (ackTimeout && sendError) {
      return res.status(500).json({
        ok: false,
        error: 'Pengiriman pesan gagal: ' + sendError.message,
        chatId
      });
    }

    if (ackPayload) {
      let ackLevel = 'server';
      if (ackPayload.ack === MessageAck.ACK_DEVICE) ackLevel = 'device';
      else if (ackPayload.ack === MessageAck.ACK_READ) ackLevel = 'read';
      else if (ackPayload.ack === MessageAck.ACK_PLAYED) ackLevel = 'played';

      const finalMsgId = ackPayload.id || sendResult || pendingEntry.serverId;

      return res.json({
        ok: true,
        messageId: finalMsgId,
        ackLevel,
        confirmed: true,
        chatId
      });
    }

    if (sendResult) {
      // waitUntilMsgSent=true sukses, tapi ACK belum/tidak datang sebelum timeout.
      return res.status(202).json({
        ok: true,
        messageId: sendResult,
        confirmed: false,
        status: 'pending_ack',
        chatId
      });
    }

    if (pendingEntry.created) {
      // message_create terdeteksi tapi tidak ada ACK — pesan mungkin belum sampai server.
      return res.status(202).json({
        ok: true,
        messageId: pendingEntry.serverId || null,
        confirmed: false,
        status: 'created_no_ack',
        chatId
      });
    }

    // Timeout atau error tanpa sendResult sama sekali.
    return res.status(202).json({
      ok: false,
      messageId: null,
      confirmed: false,
      status: 'unconfirmed',
      error: ackTimeout ? 'Timeout: konfirmasi ACK tidak diterima dalam 30 detik.' : 'Konfirmasi tidak lengkap. Pesan mungkin gagal dikirim.',
      chatId
    });
  } catch (error) {
    console.error('Gagal mengirim pesan:', error.message);
    return res.status(500).json({
      ok: false,
      error: 'Pengiriman pesan gagal.'
    });
  }
});

app.get('/diag/number', authMiddleware, async (req, res) => {
  if (!whatsappReady) {
    return res.status(503).json({
      ok: false,
      error: 'WhatsApp belum siap.'
    });
  }

  const number = req.query.number;

  if (typeof number !== 'string' ||
      !/^\d{8,15}$/.test(number)) {
    return res.status(400).json({
      ok: false,
      error: 'Nomor tidak valid.'
    });
  }

  try {
    const registered = await ensureRegistered(number, numberCache);

    return res.json({
      ok: true,
      registered
    });
  } catch (error) {
    console.error('Gagal memeriksa nomor:', error.message);
    return res.status(500).json({
      ok: false,
      error: 'Gagal memeriksa nomor.'
    });
  }
});

