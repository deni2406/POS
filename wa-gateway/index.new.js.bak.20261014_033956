/**
 * Cari entri pending berdasarkan chatId penerima dari msg.to.
 * msg.to = JID tujuan (e.g. '628xxx@c.us'), cocok dengan key chatId di pendingSends.
 */
function lookupChatId(msg) {
  if (!msg || !msg.to) return null;
  return pendingSends.get(msg.to) || null;
}

function handleSendEvent(msg, ack, isAckEvent) {
  if (!msg || !msg.id || !msg.id.fromMe) return;

  // Cari entry via msg.to (JID tujuan) — ini key chatId yang dipakai saat pendaftaran.
  const pending = lookupChatId(msg);
  if (!pending) return;

  // Simpan msg.id.id sebagai serverId (unik per pesan, dipakai untuk audit).
  if (msg.id._serialized && !pending.serverId) {
    pending.serverId = msg.id._serialized;
  }
  // Migrasi key Map dari chatId ke msg.id.id (unik per pesan).
  // Ini mencegah tabrakan saat dua pesan dikirim ke nomor yang sama berurutan
  // sebelum ACK pesan pertama tiba.
  if (msg.id.id && !pending.correlId) {
    pending.correlId = msg.id.id;
    if (pendingSends.has(chatId)) pendingSends.delete(chatId);
    pendingSends.set(msg.id.id, pending);
  }

  const isAckError = MessageAck.ACK_ERROR !== undefined && ack === MessageAck.ACK_ERROR;

  if (isAckEvent) {
    if (isAckError) {
      pending.ackError = true;
      pending.ackErrorTs = Date.now();
      clearTimeoutFor(pending);
      if (pending.reject) pending.reject(new Error('ACK_ERROR'));
      return;
    }
    // Hanya terima ACK yang masuk CONFIRMED_ACK_VALUES.
    // ACK_PENDING (0) dan nilai tak dikenal TIDAK menghasilkan konfirmasi sukses.
    if (pending.confirmed) return;
    if (ack === MessageAck.ACK_PENDING) return;
    if (!CONFIRMED_ACK_VALUES.has(ack)) return;
    pending.confirmed = true;
    pending.ack = ack;
    pending.ackTs = Date.now();
    clearTimeoutFor(pending);
    // Resolve TIDAK menghapus entry di sini — biarkan resolve() callback yang membersihkan.
    if (pending.resolve) pending.resolve({ id: msg.id._serialized, ack });
    return;
  }

  // message_create event (hanya catatan, bukan konfirmasi)
  pending.created = true;
  pending.createdTs = Date.now();
}

client.on('message_ack', (msg, ack) => {
  handleSendEvent(msg, ack, true);
});

client.on('message_create', (msg) => {
  handleSendEvent(msg, undefined, false);
});

function authMiddleware(req, res, next) {
  const supplied = req.get('x-api-token') || '';
  const a = Buffer.from(supplied);
  const b = Buffer.from(API_TOKEN);

  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {
    return res.status(401).json({ ok: false, error: 'Unauthorized' });
  }

  next();
}

