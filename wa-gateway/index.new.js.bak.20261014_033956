let whatsappReady = false;

const CACHE_PATH = path.join(__dirname, 'number-cache.json');
const CACHE_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 7 hari

function loadNumberCache() {
  try {
    if (!fs.existsSync(CACHE_PATH)) return {};
    const raw = fs.readFileSync(CACHE_PATH, 'utf8');
    return JSON.parse(raw);
  } catch (err) {
    console.error('Gagal memuat cache nomor:', err.message);
    return {};
  }
}

function saveNumberCache(cache) {
  try {
    fs.writeFileSync(CACHE_PATH, JSON.stringify(cache, null, 2), 'utf8');
  } catch (err) {
    console.error('Gagal menyimpan cache nomor:', err.message);
  }
}

function isCacheValid(number, cache) {
  const entry = cache[number];
  return entry &&
    typeof entry.registered === 'boolean' &&
    typeof entry.checkedAt === 'number' &&
    Date.now() - entry.checkedAt < CACHE_TTL_MS;
}

function isRegistered(number, cache) {
  return isCacheValid(number, cache) && cache[number].registered;
}

let numberCache = loadNumberCache();

const inFlightChecks = new Map();

async function ensureRegistered(number, cache) {
  if (isRegistered(number, cache)) return true;
  if (isCacheValid(number, cache)) return cache[number].registered;
  if (inFlightChecks.has(number)) {
    return await inFlightChecks.get(number);
  }
  const promise = (async () => {
    try {
      const wid = await client.getNumberId(number);
      const registered = Boolean(wid);
      cache[number] = { registered, checkedAt: Date.now() };
      saveNumberCache(cache);
      return registered;
    } finally {
      inFlightChecks.delete(number);
    }
  })();
  inFlightChecks.set(number, promise);
  return await promise;
}

